rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users Collection ────────────────────────────────────
    match /users/{userId} {

      // User can read & write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ── Attendance Logs Sub-collection ──────────────────
      match /attendance_logs/{date} {

        // Read & Create: owner only
        allow read, create: if request.auth != null && request.auth.uid == userId;

        // Update & Delete: allowed only within the 24-hour edit window
        allow update, delete: if request.auth != null
                              && request.auth.uid == userId
                              && resource.data.editableUntil > request.time;
      }
    }
  }
}
